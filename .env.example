# RPG Tabletop - Configurações de Ambiente

# =============================================================================
# 1. FRONTEND (Vite / Vercel / Netlify)
# =============================================================================

# URL do servidor Socket.io acessada pelo Frontend (sem barra final)
# Em desenvolvimento local:
VITE_SOCKET_SERVER_URL=http://localhost:3001

# Em produção separada (ex: Frontend na Vercel + Backend no Render/VPS):
# VITE_SOCKET_SERVER_URL=https://meu-servidor-rpg.onrender.com

# =============================================================================
# 2. BACKEND (Node.js + Socket.io / Render / Railway / VPS)
# =============================================================================

# Porta do servidor HTTP / WebSocket (o Render injeta automaticamente em produção)
PORT=3001

# Origens permitidas via CORS separadas por vírgula (padrão '*' se omitido).
# Barras finais ('/') são normalizadas automaticamente pelo servidor.
# Exemplo em produção: ALLOWED_ORIGINS=https://meu-vtt.vercel.app,https://outro-dominio.com
ALLOWED_ORIGINS=*

# Tamanho máximo de pacote Socket.io em bytes (padrão: 10000000 = 10 MB)
MAX_PAYLOAD_BYTES=10000000

# Limite máximo de mesas simultâneas em memória (padrão: 1000)
MAX_ROOMS=1000

# Limite máximo de conexões/jogadores por mesa (padrão: 64)
MAX_MEMBERS_PER_ROOM=64

# Tempo de carência (ms) antes de limpar uma sala totalmente vazia (padrão: 600000 = 10 min)
ROOM_GRACE_PERIOD_MS=600000

# Ambiente de execução (development | production)
# IMPORTANTE (Render Single-Service / All-in-One):
# Se o build rodar `npm install && npm run build`, NÃO defina NODE_ENV=production durante a etapa
# de build (ou use `npm install --include=dev && npm run build`) para não pular devDependencies
# como `typescript` e `vite` necessárias para compilar o frontend!
NODE_ENV=development

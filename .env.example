# RPG Tabletop - Configurações de Ambiente

# Porta do servidor Node.js / Socket.io (Backend)
PORT=3001

# URL do servidor Socket.io acessada pelo Frontend (Vite)
# Em desenvolvimento local:
VITE_SOCKET_SERVER_URL=http://localhost:3001

# Em produção (ex: Render.com ou VPS próprio):
# VITE_SOCKET_SERVER_URL=https://meu-servidor-rpg.onrender.com

# Ambiente de execução (development | production)
NODE_ENV=development
